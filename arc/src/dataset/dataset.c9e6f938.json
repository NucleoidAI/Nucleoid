{
  "class_declaration": "# Each object is the whole color-7 pattern in the grid. The output extends the grid right with its left-right mirror image, so the pattern meets its reflection at the old right edge\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, tag: str = 'l9100'):\n    this.x is x\n    this.y is y\n    this.width is width\n    this.height is height\n    this.orientation is orientation\n    this.volume is volume\n    this.tag is tag",
  "declarations": [
    "# Each pattern becomes l6919, a shape beside its mirror image\n$Obj.tag is l6919",
    "# It spans from its input left column to the old right edge, then the same again mirrored to the right\n$Obj.width is 2 * (canvas_width - $Obj.x@first)",
    "# The mirror image doubles its cells\n$Obj.volume is 2 * $Obj.volume@first"
  ],
  "output_canvas": "EXACT",
