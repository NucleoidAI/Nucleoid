{
  "declarations": [
    "# There is an Obj type, a single shape on the grid,\n# which has its x and y position, the width and height\n# of its box, its orientation and its color as integers\n# Orientation is the direction an object points, in degrees clockwise from north (0 up, 90 right, 180 down, 270 left)\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, color: int):\n    this.x = x\n    this.y = y\n    this.width = width\n    this.height = height\n    this.orientation = orientation\n    this.tag = 'l9100'\n    this.color = color",
    "# Every shape is repeated side by side\n$Obj.tag = 'l4305'",
    "# Every shape appears twice in total\n$Obj.repeat_count = 2",
    "# Every copy goes to the right of the one before it\n$Obj.repeat_direction = 'right'",
    "# Every repeated shape is as wide as all its copies side by side\n$Obj.width = $Obj.width@first * $Obj.repeat_count",
    "# Every repeated shape starts at the left edge of the output\n$Obj.x = 0",
    "# Every repeated shape starts at the top edge of the output\n$Obj.y = 0"
  ],
