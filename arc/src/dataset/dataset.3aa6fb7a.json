{
  "declarations": [
    "# Each object is one color-8 corner: 3 cells of a 2x2 box that meet at its vertex cell. Every corner fills the open cell of its box with color 1, completing the square\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, color: int):\n    this.x is x\n    this.y is y\n    this.width is width\n    this.height is height\n    this.orientation is orientation\n    this.volume is volume\n    this.tag is l6747\n    this.color is color",
    "# Each corner becomes l3337, a corner with its inside marker\n$Obj.tag is l3337",
    "# The open cell of its box, diagonally opposite its vertex, turns color 1\n$Obj.marker_color is 1",
    "# The marker adds one cell to its 3 input cells\n$Obj.volume is $Obj.volume@first + 1"
  ],
