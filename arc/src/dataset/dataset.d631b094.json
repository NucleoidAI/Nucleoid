{
  "declarations": [
    "# Each object is all the cells of the one color in the grid, touching or not. The output lines them up as a one-row bar of that color, one cell per input cell\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, color: int):\n    this.x is x\n    this.y is y\n    this.width is width\n    this.height is height\n    this.orientation is orientation\n    this.volume is volume\n    this.tag is l9100\n    this.color is color",
    "# Each group becomes l3058, a horizontal bar\n$Obj.tag is l3058",
    "# The bar has one column per input cell\n$Obj.width is $Obj.volume",
    "# The bar is one row tall\n$Obj.height is 1",
    "# A bar of 2 or more cells lies at 90; a single cell is 0\n$Obj.orientation is 90 if $Obj.width > 1 else 0",
    "# The cropped output starts at the left end of the bar\n$Obj.x is 0",
    "# The cropped output starts at the row of the bar\n$Obj.y is 0"
  ],
