{
  "declarations": [
    "# There is an Obj type, the whole pattern of colored cells on the canvas,\n# which has its x and y position, its orientation and its canvas's width\n# as integers, and its points, the column and row of each of its cells\n# in reading order, as a list\nclass Obj(x: int, y: int, orientation: int, canvas_width: int, points: list):\n    this.x = x\n    this.y = y\n    this.orientation = orientation\n    this.tag = 'l9100'\n    this.canvas_width = canvas_width\n    this.points = points",
    "# Every pattern becomes a single output point\n$Obj.tag = 'l7544'",
    "# A pattern is symmetric when the mirror image of each of its points\n# across the canvas's vertical center line, in the same row and as far\n# from the right edge as the point is from the left edge,\n# is one of its points too\n$Obj.symmetric = all point in $Obj.points: $Obj.points.includes([$Obj.canvas_width - 1 - point[0], point[1]])",
    "# Every output point is color 1 when its pattern is symmetric\n# and color 7 otherwise\n$Obj.fill_color = 1 if $Obj.symmetric else 7",
    "# Every output point sits in the left column\n$Obj.x = 0",
    "# Every output point sits in the top row\n$Obj.y = 0"
  ],
  "output_canvas": "FIT",
