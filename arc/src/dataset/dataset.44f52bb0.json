{
  "declarations": [
    "# Each object is the whole color-2 pattern in the grid. The output is one cell: 1 when the pattern is its own left-right mirror image, otherwise 7\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, points: list):\n    # Left column of its box\n    this.x is x\n    # Top row of its box\n    this.y is y\n    # Columns of its box\n    this.width is width\n    # Rows of its box\n    this.height is height\n    # A corner points toward its vertex; any other pattern is 0\n    this.orientation is orientation\n    # Number of its cells\n    this.volume is volume\n    # l9100 names a single shape\n    this.tag is l9100\n    # Grid [x, y] of each of its cells, row by row\n    this.points is points",
    "# Each pattern becomes l7544, a single point\n$Obj.tag is l7544",
    "# The answer cell is one column wide\n$Obj.width is 1",
    "# The answer cell is one row tall\n$Obj.height is 1",
    "# A point points nowhere: 0\n$Obj.orientation is 0",
    "# True when the mirror of every cell across the vertical center line of the grid is also a cell\n$Obj.symmetric is all point in $Obj.points: $Obj.points.includes([canvas_width - 1 - point[0], point[1]])",
    "# The answer cell is 1 for a symmetric pattern and 7 otherwise\n$Obj.fill_color is 1 if $Obj.symmetric else 7",
    "# The answer cell sits at column 0 of the cropped output\n$Obj.x is 0",
    "# The answer cell sits at row 0 of the cropped output\n$Obj.y is 0",
    "# The answer has one cell\n$Obj.volume is $Obj.width * $Obj.height"
  ],
