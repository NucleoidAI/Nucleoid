{
  "declarations": [
    "# There is an Obj type, a single point of one color on the canvas,\n# which has its x and y position, its orientation, its color\n# and its canvas's height as integers\nclass Obj(x: int, y: int, orientation: int, color: int, canvas_height: int):\n    this.x = x\n    this.y = y\n    this.orientation = orientation\n    this.tag = 'l7544'\n    this.color = color\n    this.canvas_height = canvas_height",
    "# Every point becomes a vertical bar\n$Obj.tag = 'l6953'",
    "# Every bar starts at its point and reaches down\n# to the bottom row of the canvas\n$Obj.bar_height = $Obj.canvas_height - $Obj.y"
  ],
