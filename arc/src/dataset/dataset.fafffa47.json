{
  "declarations": [
    "# Orientation is the direction an object points, in degrees clockwise from north (0 up, 90 right, 180 down, 270 left)\n# Each object is the whole figure of one panel, the top or bottom half of the canvas, including any disconnected pieces.\n# holes are the [column, row] cells of its panel that the figure leaves empty, counted from the top-left corner of the panel.\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, holes: list):\n    this.x is x\n    this.y is y\n    this.width is width\n    this.height is height\n    this.orientation is orientation\n    this.tag is l9100\n    this.holes is holes",
    "$Obj.tag is l8372",
    "# Overlay the panels and keep the holes that every panel shares.\n$Obj.points is $Obj.holes.filter(hole => all figure in Obj: figure.holes.includes(hole))",
    "$Obj.fill_color is 2",
    "$Obj.x is $Obj.points.min(point => point[0])",
    "$Obj.y is $Obj.points.min(point => point[1])",
    "$Obj.width is $Obj.points.max(point => point[0]) - $Obj.x + 1",
    "$Obj.height is $Obj.points.max(point => point[1]) - $Obj.y + 1"
  ],
