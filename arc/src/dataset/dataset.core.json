{
  "declarations": [
    "# Each object is one corner: 3 cells of a 2x2 box that meet at its vertex cell, pointing toward that vertex. An all-9 corner gains a color-4 marker one cell diagonally past its vertex\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, vertex_color: int, vertical_segment_color: int, horizontal_segment_color: int):\n    # Left column of its bounding box\n    this.x is x\n    # Top row of its bounding box\n    this.y is y\n    # Columns of its bounding box\n    this.width is width\n    # Rows of its bounding box\n    this.height is height\n    # Direction it points, in degrees clockwise from up: 0 up, 90 right, 180 down, 270 left, 45 up-right, 135 down-right, 225 down-left, 315 up-left\n    this.orientation is orientation\n    # Number of its cells\n    this.volume is volume\n    # l6747 names a corner\n    this.tag is l6747\n    # Color of its vertex cell, where its two arms meet\n    this.vertex_color is vertex_color\n    # Color of its vertical arm, the cell above or below the vertex\n    this.vertical_segment_color is vertical_segment_color\n    # Color of its horizontal arm, the cell left or right of the vertex\n    this.horizontal_segment_color is horizontal_segment_color",
    "# A corner whose 3 cells are all color 9 gains a color-4 marker one cell diagonally past its vertex\nif $Obj.vertex_color is 9 and $Obj.vertical_segment_color is 9 and $Obj.horizontal_segment_color is 9:\n    # It becomes l6624, a corner with its outside marker\n    $Obj.tag is l6624\n    # The marker color\n    $Obj.marker_color is 4\n    # Its box grows one column left when its vertex is on the left, pointing down-left or up-left\n    $Obj.x is $Obj.x@first - 1 if $Obj.orientation > 180 else $Obj.x@first\n    # Its box grows one row up when its vertex is on top, pointing up-left or up-right\n    $Obj.y is $Obj.y@first - 1 if $Obj.orientation < 90 or $Obj.orientation > 270 else $Obj.y@first\n    # 3 columns: the corner and the marker column\n    $Obj.width is $Obj.width@first + 1\n    # 3 rows: the corner and the marker row\n    $Obj.height is $Obj.height@first + 1\n    # The marker adds one cell; @first reads a value as it was before any rule ran\n    $Obj.volume is $Obj.volume@first + 1"
  ],
  "output_canvas": "EXACT",
