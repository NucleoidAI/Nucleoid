{
  "declarations": [
    "# There is an Obj type, a corner where a vertical and\n# a horizontal segment meet at a vertex,\n# which has its x and y position, its width and height,\n# its orientation and the colors of its vertex\n# and both segments as integers,\n# and every corner starts without a marker\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, vertex_color: int, vertical_segment_color: int, horizontal_segment_color: int):\n    this.x = x\n    this.y = y\n    this.width = width\n    this.height = height\n    this.orientation = orientation\n    this.tag = 'l6747'\n    this.vertex_color = vertex_color\n    this.vertical_segment_color = vertical_segment_color\n    this.horizontal_segment_color = horizontal_segment_color\n    this.marker_color = 0",
    "# A corner whose vertex and both segments are color 9\n# gains a color-4 marker diagonally outside its vertex,\n# toward its orientation, so its shape is one column wider\n# and one row taller and starts one column left when it\n# points west and one row up when it points north\nif $Obj.vertex_color == 9 and $Obj.vertical_segment_color == 9 and $Obj.horizontal_segment_color == 9:\n    $Obj.tag = 'l6624'\n    $Obj.marker_color = 4\n    $Obj.x = $Obj.x@first - 1 if $Obj.orientation > 180 else $Obj.x@first\n    $Obj.y = $Obj.y@first - 1 if $Obj.orientation < 90 or $Obj.orientation > 270 else $Obj.y@first\n    $Obj.width = $Obj.width@first + 1\n    $Obj.height = $Obj.height@first + 1"
  ],
