{
  "class_declaration": "# Each object is all the cells of one color. The output stands each color as a vertical bar of one cell per input cell, hanging from the top row, ordered from the most cells on the left to the fewest on the right\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, color: int):\n    this.x is x\n    this.y is y\n    this.width is width\n    this.height is height\n    this.orientation is orientation\n    this.volume is volume\n    this.tag is l9100\n    this.color is color",
  "declarations": [
    "# Each color becomes l6953, a vertical bar\n$Obj.tag is l6953",
    "# The bar is one column wide\n$Obj.width is 1",
    "# A vertical bar stands at 0\n$Obj.orientation is 0",
    "# The bar has one row per input cell\n$Obj.height is $Obj.volume",
    "# Its column is the number of taller bars: the most cells go leftmost\n$Obj.x is Obj.filter(other => other.height > $Obj.height).length",
    "# Every bar hangs from the top row\n$Obj.y is 0"
  ],
