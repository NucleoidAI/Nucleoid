    "$Obj.fill_color = 2",
    "$Obj.width = min of [$Obj.cell_count, canvas_width]",
    "$Obj.height = 1 + $Obj.cell_count - $Obj.width",
    "$Obj.orientation = 90 if $Obj.height is 1 and $Obj.width > 1 else 0",
    "$Obj.x = 0",
    "$Obj.y = 0"
