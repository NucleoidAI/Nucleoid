{
  "declarations": [
    "# There is an Obj type, the whole block of colored cells on the canvas,\n# which has its x and y position, the width and height of its box,\n# and its orientation as integers\n# Orientation is the direction an object points, in degrees clockwise from north (0 up, 90 right, 180 down, 270 left)\nclass Obj(x: int, y: int, width: int, height: int, orientation: int):\n    this.x = x\n    this.y = y\n    this.width = width\n    this.height = height\n    this.orientation = orientation\n    this.tag = 'l9100'",
    "# Every block is turned a half turn, 180 degrees, and redrawn\n$Obj.orientation = ($Obj.orientation@first + 180) % 360",
    "# The half turn is about the canvas center, so the block's box\n# is now as far from the right edge as it was from the left edge\n$Obj.x = canvas_width - $Obj.x@first - $Obj.width",
    "# The half turn also puts the block's box as far\n# from the bottom edge as it was from the top edge\n$Obj.y = canvas_height - $Obj.y@first - $Obj.height"
  ],
