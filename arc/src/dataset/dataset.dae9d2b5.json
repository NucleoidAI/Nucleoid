  "class_declaration": "# Each object is the whole figure in one 3x3 half of the grid, all its cells: color 4 in the left half, color 3 in the right half. The output overlays the two halves on a 3x3 grid and draws every covered cell in color 6\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, tag: str = 'l9100'):\n    this.x = x\n    this.y = y\n    this.width = width\n    this.height = height\n    this.orientation = orientation\n    this.volume = volume\n    this.tag = tag",
  "declarations": [
    "# A figure in the right half slides left by half the grid width, onto the left half\nif $Obj.x@first >= canvas_width / 2:\n    $Obj.x = $Obj.x@first - canvas_width / 2",
    "# Every figure is drawn in color 6, so the overlay shows the cells of both\n$Obj.fill_color = 6"
  ],
