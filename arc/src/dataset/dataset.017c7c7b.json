{
  "declarations": [
    "# There is an Obj type, the whole pattern of colored cells on the canvas,\n# which has its x and y position, the width and height of its box,\n# its orientation, its color, and its period, the number of rows\n# after which the pattern starts over, as integers\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, color: int, period: int):\n    this.x = x\n    this.y = y\n    this.width = width\n    this.height = height\n    this.orientation = orientation\n    this.tag = 'l9100'\n    this.color = color\n    this.period = period",
    "# Every pattern grows by repeating its rows every period rows\n$Obj.tag = 'l8384'",
    "# Every pattern grows down from its top row, which stays in place\n$Obj.extension_direction = 'down'",
    "# Every pattern grows to one and a half times its height\n$Obj.height = $Obj.height@first * 3 / 2",
    "# Every cell of the pattern turns color 2\n$Obj.color = 2"
  ],
