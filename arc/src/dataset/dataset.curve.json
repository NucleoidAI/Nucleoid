{
  "declarations": [
    "# Each object is one single-cell point. A color-4 point gains a V of color 8 above it, and a color-9 point a V of color 2 below it\nclass Obj(x: int, y: int, width: int, height: int, orientation: int, volume: int, vertex_color: int):\n    # Its column\n    this.x is x\n    # Its row\n    this.y is y\n    # One column: a single cell\n    this.width is width\n    # One row\n    this.height is height\n    # A point points nowhere: 0\n    this.orientation is orientation\n    # Its one cell\n    this.volume is volume\n    # l7544 names a single point\n    this.tag is l7544\n    # Its color, which becomes the vertex of the V\n    this.vertex_color is vertex_color",
    "# A color-4 point gains two color-8 cells diagonally above it, a V that points down at it\nif $Obj.vertex_color is 4:\n    # It becomes l6840, a point under a V of 8\n    $Obj.tag is l6840\n    # The V arms are color 8\n    $Obj.rim_color is 8\n    # The V box starts one column left of the point\n    $Obj.x is $Obj.x@first - 1\n    # The V box starts one row above the point\n    $Obj.y is $Obj.y@first - 1\n    # 3 columns: one more on each side\n    $Obj.width is $Obj.width@first + 2\n    # 2 rows: the arms row and the point row\n    $Obj.height is $Obj.height@first + 1\n    # The V points down, toward the point\n    $Obj.orientation is 180\n    # The point and its 2 arm cells\n    $Obj.volume is $Obj.volume@first + 2",
    "# A color-9 point gains two color-2 cells diagonally below it, a V that points up at it, so its orientation stays 0\nif $Obj.vertex_color is 9:\n    # It becomes l9906, a point over a V of 2\n    $Obj.tag is l9906\n    # The V arms are color 2\n    $Obj.rim_color is 2\n    # The V box starts one column left of the point\n    $Obj.x is $Obj.x@first - 1\n    # 3 columns: one more on each side\n    $Obj.width is $Obj.width@first + 2\n    # 2 rows: the point row and the arms row\n    $Obj.height is $Obj.height@first + 1\n    # The point and its 2 arm cells\n    $Obj.volume is $Obj.volume@first + 2"
  ],
  "output_canvas": "EXACT",
